<?xml version="1.0"?>

<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>leader_follower</name>

  <version>0.0.0</version>

  <description>
    Leader-Follower Navigation using ROS 2, Gazebo Sim, TF2 and LiDAR safety.
  </description>

  <maintainer email="mohammed-arshad-s@todo.todo">
    mohammed-arshad-s
  </maintainer>

  <license>Apache-2.0</license>

  <!-- ========================================================= -->
  <!-- Python / ROS 2 -->
  <!-- ========================================================= -->

  <exec_depend>rclpy</exec_depend>

  <!-- ========================================================= -->
  <!-- ROS message packages -->
  <!-- ========================================================= -->

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <!-- ========================================================= -->
  <!-- TF2 -->
  <!-- ========================================================= -->

  <exec_depend>tf2_ros</exec_depend>

  <!-- ========================================================= -->
  <!-- Launch -->
  <!-- ========================================================= -->

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- ========================================================= -->
  <!-- Gazebo / ros_gz -->
  <!-- ========================================================= -->

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  
  <!-- ========================================================= -->
  <!-- Nav2 -->
  <!-- ========================================================= -->

  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <!-- ========================================================= -->
  <!-- Tests -->
  <!-- ========================================================= -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- ========================================================= -->
  <!-- Build type -->
  <!-- ========================================================= -->

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
