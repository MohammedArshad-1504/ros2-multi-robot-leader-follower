<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ========================================================= -->
    <!-- LIDAR MACRO                                               -->
    <!-- ========================================================= -->

    <xacro:macro
        name="lidar"
        params="name radius height topic">


        <!-- ===================================================== -->
        <!-- LIDAR LINK                                            -->
        <!-- ===================================================== -->

        <link name="${name}_link">

            <visual>

                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>

                <geometry>

                    <cylinder
                        radius="${radius}"
                        length="${height}"/>

                </geometry>

                <material name="${name}_material">

                    <color
                        rgba="0.0 0.0 1.0 1.0"/>

                </material>

            </visual>


            <collision>

                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>

                <geometry>

                    <cylinder
                        radius="${radius}"
                        length="${height}"/>

                </geometry>

            </collision>


            <inertial>

                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>

                <mass value="0.5"/>

                <inertia
                    ixx="0.0005"
                    ixy="0.0"
                    ixz="0.0"
                    iyy="0.0005"
                    iyz="0.0"
                    izz="0.0005"/>

            </inertial>

        </link>


        <!-- ===================================================== -->
        <!-- GAZEBO GPU LIDAR                                     -->
        <!-- ===================================================== -->

        <gazebo reference="${name}_link">

            <sensor
                name="${name}_sensor"
                type="gpu_lidar">

                <always_on>true</always_on>

                <visualize>true</visualize>

                <update_rate>10</update_rate>

                <!-- Robot-specific topic -->

                <topic>${topic}</topic>

                <!-- Sensor is mounted directly on the link -->

                <pose>
                    0 0 0 0 0 0
                </pose>


                <!-- ================================================= -->
                <!-- SCAN                                            -->
                <!-- ================================================= -->

                <lidar>

                    <scan>

                        <horizontal>

                            <samples>720</samples>

                            <resolution>1</resolution>

                            <min_angle>-3.14159</min_angle>

                            <max_angle>3.14159</max_angle>

                        </horizontal>

                    </scan>


                    <range>

                        <min>0.10</min>

                        <max>12.0</max>

                        <resolution>0.01</resolution>

                    </range>

                </lidar>


                <!-- ================================================= -->
                <!-- NOISE                                           -->
                <!-- ================================================= -->

                <noise>

                    <type>gaussian</type>

                    <mean>0.0</mean>

                    <stddev>0.01</stddev>

                </noise>


                <!-- ================================================= -->
                <!-- GAZEBO FRAME                                    -->
                <!-- ================================================= -->

                <gz_frame_id>
                    ${name}_link
                </gz_frame_id>

            </sensor>

        </gazebo>

    </xacro:macro>

</robot>
