<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ========================================================= -->
    <!-- CAMERA MACRO                                              -->
    <!-- ========================================================= -->

    <xacro:macro
        name="camera"
        params="name x y z length width height topic parent_link">


        <!-- ===================================================== -->
        <!-- CAMERA LINK                                           -->
        <!-- ===================================================== -->

        <link name="${name}_link">

            <visual>

                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>

                <geometry>

                    <box
                        size="${length} ${width} ${height}"/>

                </geometry>

                <material name="${name}_material">

                    <color
                        rgba="0.05 0.05 0.05 1.0"/>

                </material>

            </visual>


            <collision>

                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>

                <geometry>

                    <box
                        size="${length} ${width} ${height}"/>

                </geometry>

            </collision>


            <inertial>

                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>

                <mass value="0.2"/>

                <inertia
                    ixx="0.0001"
                    ixy="0.0"
                    ixz="0.0"
                    iyy="0.0001"
                    iyz="0.0"
                    izz="0.0001"/>

            </inertial>

        </link>


        <!-- ===================================================== -->
        <!-- CAMERA JOINT                                          -->
        <!-- ===================================================== -->

        <joint
            name="${name}_joint"
            type="fixed">

            <parent link="${parent_link}"/>

            <child link="${name}_link"/>

            <origin
                xyz="${x} ${y} ${z}"
                rpy="0 0 0"/>

        </joint>


        <!-- ===================================================== -->
        <!-- GAZEBO CAMERA                                         -->
        <!-- ===================================================== -->

        <gazebo reference="${name}_link">

            <sensor
                name="${name}_sensor"
                type="camera">

                <always_on>true</always_on>

                <visualize>true</visualize>

                <update_rate>30</update_rate>

                <topic>${topic}</topic>

                <gz_frame_id>${name}_link</gz_frame_id>

                <camera>

                    <horizontal_fov>1.0472</horizontal_fov>

                    <image>

                        <width>640</width>

                        <height>480</height>

                        <format>R8G8B8</format>

                    </image>

                    <clip>

                        <near>0.05</near>

                        <far>20.0</far>

                    </clip>

                    <distortion>

                        <k1>0.0</k1>
                        <k2>0.0</k2>
                        <k3>0.0</k3>
                        <p1>0.0</p1>
                        <p2>0.0</p2>

                        <center>
                            0.5 0.5
                        </center>

                    </distortion>

                </camera>

            </sensor>

        </gazebo>

    </xacro:macro>

</robot>
