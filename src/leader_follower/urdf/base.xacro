<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ========================================================= -->
    <!-- ROBOT BASE / CHASSIS                                     -->
    <!-- ========================================================= -->

    <xacro:macro
        name="robot_base"
        params="length width height mass link_name">

        <link name="${link_name}">

            <!-- ================================================= -->
            <!-- VISUAL                                           -->
            <!-- ================================================= -->

            <visual>

                <origin
                    xyz="0 0 ${height / 2.0}"
                    rpy="0 0 0"/>

                <geometry>

                    <box
                        size="${length} ${width} ${height}"/>

                </geometry>

                <material name="${link_name}_material">

                    <color
                        rgba="0.30 0.30 0.30 1.0"/>

                </material>

            </visual>


            <!-- ================================================= -->
            <!-- COLLISION                                         -->
            <!-- ================================================= -->

            <collision>

                <origin
                    xyz="0 0 ${height / 2.0}"
                    rpy="0 0 0"/>

                <geometry>

                    <box
                        size="${length} ${width} ${height}"/>

                </geometry>

            </collision>


            <!-- ================================================= -->
            <!-- INERTIAL                                          -->
            <!-- ================================================= -->

            <inertial>

                <origin
                    xyz="0 0 ${height / 2.0}"
                    rpy="0 0 0"/>

                <mass value="${mass}"/>

                <inertia
                    ixx="${(mass / 12.0) * (width * width + height * height)}"
                    ixy="0.0"
                    ixz="0.0"
                    iyy="${(mass / 12.0) * (length * length + height * height)}"
                    iyz="0.0"
                    izz="${(mass / 12.0) * (length * length + width * width)}"/>

            </inertial>

        </link>

    </xacro:macro>

</robot>
